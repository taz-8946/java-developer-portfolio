<script>
// ─── Navbar scroll + active section ───
const navbar = document.getElementById('navbar');
const sections = ['home','about','skills','projects','education','contact'];
const navLinks = document.querySelectorAll('.nav-links a:not(.nav-resume), .mobile-menu a:not(:last-child)');
const mobileToggle = document.getElementById('mobileToggle');
const mobileMenu = document.getElementById('mobileMenu');

window.addEventListener('scroll', () => {
  navbar.classList.toggle('scrolled', window.scrollY > 50);
  let current = 'home';
  for (let i = sections.length - 1; i >= 0; i--) {
    const el = document.getElementById(sections[i]);
    if (el && el.getBoundingClientRect().top <= 120) { current = sections[i]; break; }
  }
  navLinks.forEach(link => {
    const isActive = link.getAttribute('href') === '#' + current;
    link.classList.toggle('active', isActive);
  });
}, { passive: true });

mobileToggle.addEventListener('click', () => mobileMenu.classList.toggle('open'));
mobileMenu.querySelectorAll('a').forEach(a => a.addEventListener('click', () => mobileMenu.classList.remove('open')));

// ─── Typewriter ───
(function() {
  const el = document.getElementById('tagline');
  const text = 'CSM Graduate | AI & ML Enthusiast | Python & Java Developer';
