<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Mohammad Taz S — Portfolio</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800&display=swap" rel="stylesheet">
<style>
*,*::before,*::after{margin:0;padding:0;box-sizing:border-box}
html{scroll-behavior:smooth;scroll-padding-top:4rem}
body{font-family:'Inter',system-ui,-apple-system,sans-serif;background:#0a0a0f;color:#f5f5f5;-webkit-font-smoothing:antialiased;overflow-x:hidden}
::selection{background:rgba(34,211,238,0.3)}
::-webkit-scrollbar{width:6px}
::-webkit-scrollbar-track{background:#111118}
::-webkit-scrollbar-thumb{background:#333;border-radius:3px}
::-webkit-scrollbar-thumb:hover{background:#555}
a{text-decoration:none;color:inherit}

/* ─── Animations ─── */
@keyframes fadeUp{from{opacity:0;transform:translateY(24px)}to{opacity:1;transform:translateY(0)}}
@keyframes pulse{0%,100%{opacity:.1}50%{opacity:.18}}
@keyframes pulse2{0%,100%{opacity:.5}50%{opacity:.7}}
@keyframes bounce{0%,100%{transform:translateX(-50%) translateY(0)}50%{transform:translateX(-50%) translateY(8px)}}
@keyframes barGrow{from{width:0}}
@keyframes glow{0%,100%{box-shadow:0 0 20px rgba(34,211,238,0.15)}50%{box-shadow:0 0 40px rgba(34,211,238,0.25)}}

.fade-in{opacity:0;animation:fadeUp .7s ease-out forwards}
.delay-1{animation-delay:.1s}.delay-2{animation-delay:.2s}.delay-3{animation-delay:.3s}
.delay-4{animation-delay:.4s}.delay-5{animation-delay:.5s}.delay-6{animation-delay:.6s}
.delay-7{animation-delay:.7s}.delay-8{animation-delay:.8s}

/* ─── Navbar ─── */
.navbar{position:fixed;top:0;left:0;right:0;z-index:100;transition:all .3s;background:transparent}
.navbar.scrolled{background:rgba(10,10,15,.92);backdrop-filter:blur(12px);border-bottom:1px solid rgba(255,255,255,.04);box-shadow:0 4px 24px rgba(0,0,0,.3)}
.nav-inner{max-width:72rem;margin:0 auto;padding:0 1.5rem;height:4rem;display:flex;align-items:center;justify-content:space-between}
.nav-logo{font-size:1.25rem;font-weight:800;background:linear-gradient(135deg,#22d3ee,#3b82f6);-webkit-background-clip:text;-webkit-text-fill-color:transparent;background-clip:text}
.nav-links{display:flex;align-items:center;gap:2rem}
.nav-links a{font-size:.875rem;font-weight:500;color:#9ca3af;transition:color .2s}
.nav-links a:hover,.nav-links a.active{color:#22d3ee}
.nav-resume{display:flex;align-items:center;gap:.375rem;padding:.5rem 1rem;font-size:.875rem;font-weight:500;background:linear-gradient(135deg,rgba(34,211,238,.1),rgba(59,130,246,.1));border:1px solid rgba(34,211,238,.2);border-radius:.5rem;color:#22d3ee;transition:all .2s}
.nav-resume:hover{background:rgba(34,211,238,.2)}
.nav-resume svg{width:14px;height:14px}
.mobile-toggle{display:none;background:none;border:none;color:#9ca3af;cursor:pointer;padding:4px}
.mobile-toggle:hover{color:#fff}
.mobile-menu{display:none;overflow:hidden;max-height:0;transition:max-height .3s;background:rgba(10,10,15,.96);backdrop-filter:blur(12px);border-bottom:1px solid rgba(255,255,255,.04)}
.mobile-menu.open{max-height:20rem}
.mobile-menu a{display:block;padding:.5rem 1.5rem;font-size:.875rem;font-weight:500;color:#9ca3af;transition:color .2s}
.mobile-menu a:hover,.mobile-menu a.active{color:#22d3ee}

/* ─── Hero ─── */
.hero{position:relative;min-height:100vh;display:flex;align-items:center;justify-content:center;overflow:hidden}
.hero-bg{position:absolute;inset:0}
.hero-bg .g1{position:absolute;top:25%;left:25%;width:24rem;height:24rem;background:rgba(34,211,238,.08);border-radius:50%;filter:blur(80px);animation:pulse 4s ease-in-out infinite}
.hero-bg .g2{position:absolute;bottom:25%;right:25%;width:24rem;height:24rem;background:rgba(59,130,246,.08);border-radius:50%;filter:blur(80px);animation:pulse 4s ease-in-out infinite 1s}
.hero-bg .g3{position:absolute;top:50%;left:50%;transform:translate(-50%,-50%);width:36rem;height:36rem;background:rgba(168,85,247,.04);border-radius:50%;filter:blur(80px);animation:pulse 4s ease-in-out infinite 2s}
.hero-bg .grid{position:absolute;inset:0;opacity:.03;background-image:linear-gradient(rgba(255,255,255,.1) 1px,transparent 1px),linear-gradient(90deg,rgba(255,255,255,.1) 1px,transparent 1px);background-size:60px 60px}
.hero-content{position:relative;z-index:10;max-width:72rem;width:100%;margin:0 auto;padding:0 1.5rem;display:flex;flex-direction:row;align-items:center;justify-content:space-between;gap:4rem}
.hero-text{flex:1;text-align:center}
.hero-text .location{display:inline-flex;align-items:center;gap:.5rem;padding:.5rem 1rem;border-radius:9999px;background:rgba(255,255,255,.04);border:1px solid rgba(255,255,255,.08);font-size:.875rem;color:#9ca3af;margin-bottom:1rem}
.hero-text .location svg{width:14px;height:14px;color:#22d3ee}
.hero-text h1{font-size:3rem;font-weight:800;line-height:1.15;margin-bottom:1rem}
.hero-text h1 span.grad{background:linear-gradient(135deg,#22d3ee,#3b82f6,#a855f7);-webkit-background-clip:text;-webkit-text-fill-color:transparent;background-clip:text}
.hero-text .tagline{font-size:1.125rem;color:#9ca3af;font-weight:300;margin-bottom:1.5rem;min-height:1.75rem}
.hero-text .desc{font-size:1rem;color:#6b7280;margin-bottom:2rem;max-width:36rem;margin-left:auto;margin-right:auto}
.hero-btns{display:flex;flex-wrap:wrap;align-items:center;justify-content:center;gap:.75rem}
.btn-primary{padding:.75rem 1.75rem;background:linear-gradient(135deg,#06b6d4,#2563eb);color:#fff;font-weight:600;border-radius:.75rem;border:none;cursor:pointer;font-size:.9rem;transition:all .3s;font-family:inherit}
.btn-primary:hover{box-shadow:0 8px 24px rgba(6,182,212,.25);transform:translateY(-2px)}
.btn-purple{padding:.75rem 1.75rem;background:linear-gradient(135deg,#a855f7,#ec4899);color:#fff;font-weight:600;border-radius:.75rem;border:none;cursor:pointer;font-size:.9rem;transition:all .3s;display:inline-flex;align-items:center;gap:.5rem;font-family:inherit}
.btn-purple:hover{box-shadow:0 8px 24px rgba(168,85,247,.25);transform:translateY(-2px)}
.btn-outline{padding:.75rem 1.75rem;background:transparent;border:1px solid rgba(255,255,255,.08);color:#fff;font-weight:600;border-radius:.75rem;cursor:pointer;font-size:.9rem;transition:all .3s;font-family:inherit}
.btn-outline:hover{background:rgba(255,255,255,.04)}
.btn-icon{padding:.75rem;border:1px solid rgba(255,255,255,.08);border-radius:.75rem;background:transparent;color:#9ca3af;cursor:pointer;transition:all .3s;display:inline-flex;align-items:center;justify-content:center}
.btn-icon:hover{color:#fff;background:rgba(255,255,255,.04)}
.btn-icon svg{width:18px;height:18px}
.hero-photo{flex-shrink:0;position:relative}
.hero-photo .glow{position:absolute;inset:-8px;background:linear-gradient(135deg,#22d3ee,#3b82f6,#a855f7);border-radius:50%;filter:blur(16px);opacity:.5;animation:pulse2 3s ease-in-out infinite;transition:opacity .5s}
.hero-photo:hover .glow{opacity:.7}
.hero-photo img{position:relative;width:16rem;height:16rem;object-fit:cover;border-radius:50%;box-shadow:0 25px 50px rgba(34,211,238,.08);ring:4px solid rgba(255,255,255,.08);border:4px solid rgba(255,255,255,.08)}
.scroll-indicator{position:absolute;bottom:2rem;left:50%;transform:translateX(-50%);color:#6b7280;cursor:pointer;transition:color .2s;animation:bounce 2s infinite}
.scroll-indicator:hover{color:#22d3ee}
.scroll-indicator svg{width:24px;height:24px}

/* ─── Section shared ─── */
.section{padding:6rem 1.5rem}
.section-center{text-align:center;margin-bottom:4rem}
.section-subtitle{color:#22d3ee;font-size:.875rem;font-weight:600;text-transform:uppercase;letter-spacing:.1em;margin-bottom:.75rem}
.section-title{font-size:2.5rem;font-weight:800;color:#fff}
.section-title span{background:linear-gradient(135deg,#22d3ee,#3b82f6);-webkit-background-clip:text;-webkit-text-fill-color:transparent;background-clip:text}

/* ─── About ─── */
.about-grid{display:grid;grid-template-columns:1fr 1fr;gap:3rem;align-items:center;max-width:72rem;margin:0 auto}
.about-text p{color:#9ca3af;font-size:1.125rem;line-height:1.75;margin-bottom:1.5rem}
.about-text .white{color:#fff;font-weight:500}
.about-text .italic{font-style:italic;color:#d1d5db}
.about-highlights{display:grid;grid-template-columns:1fr 1fr;gap:1rem}
.highlight-card{padding:1.25rem;border-radius:1rem;background:rgba(255,255,255,.015);border:1px solid rgba(255,255,255,.04);transition:all .3s;cursor:default}
.highlight-card:hover{border-color:rgba(255,255,255,.08);transform:translateY(-4px)}
.highlight-icon{width:2.5rem;height:2.5rem;border-radius:.75rem;display:flex;align-items:center;justify-content:center;margin-bottom:.75rem;transition:transform .3s}
.highlight-card:hover .highlight-icon{transform:scale(1.1)}
.highlight-icon svg{width:18px;height:18px;color:#fff}
.highlight-card h3{color:#fff;font-weight:600;font-size:.875rem;margin-bottom:.25rem}
.highlight-card p{color:#6b7280;font-size:.75rem;line-height:1.5}
.grad-1{background:linear-gradient(135deg,#06b6d4,#2563eb)}
.grad-2{background:linear-gradient(135deg,#3b82f6,#a855f7)}
.grad-3{background:linear-gradient(135deg,#a855f7,#ec4899)}
.grad-4{background:linear-gradient(135deg,#ec4899,#f43f5e)}

/* ─── Skills ─── */
.skills-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:2rem;max-width:72rem;margin:0 auto}
.skill-card{padding:1.5rem;border-radius:1rem;background:rgba(255,255,255,.015);border:1px solid rgba(255,255,255,.04);transition:all .3s}
.skill-card:hover{border-color:rgba(255,255,255,.08)}
.skill-card h3{font-size:1.125rem;font-weight:600;margin-bottom:1.5rem}
.skill-card h3.g1{background:linear-gradient(135deg,#22d3ee,#3b82f6);-webkit-background-clip:text;-webkit-text-fill-color:transparent;background-clip:text}
.skill-card h3.g2{background:linear-gradient(135deg,#3b82f6,#a855f7);-webkit-background-clip:text;-webkit-text-fill-color:transparent;background-clip:text}
.skill-card h3.g3{background:linear-gradient(135deg,#a855f7,#ec4899);-webkit-background-clip:text;-webkit-text-fill-color:transparent;background-clip:text}
.skill-item{margin-bottom:1.25rem}
.skill-item:last-child{margin-bottom:0}
.skill-header{display:flex;justify-content:space-between;margin-bottom:.5rem}
.skill-name{color:#d1d5db;font-size:.875rem;font-weight:500}
.skill-pct{color:#6b7280;font-size:.875rem}
.skill-bar{height:.5rem;border-radius:9999px;background:rgba(255,255,255,.04);overflow:hidden}
.skill-fill{height:100%;border-radius:9999px;width:0;transition:width 1.2s ease-out}
.skill-fill.animated{transition:width 1.2s ease-out}
.skill-fill.g1{background:linear-gradient(135deg,#22d3ee,#3b82f6)}
.skill-fill.g2{background:linear-gradient(135deg,#3b82f6,#a855f7)}
.skill-fill.g3{background:linear-gradient(135deg,#a855f7,#ec4899)}

/* ─── Projects ─── */
.projects-grid{display:grid;grid-template-columns:1fr 1fr;gap:2rem;max-width:72rem;margin:0 auto}
.project-card{border-radius:1rem;background:rgba(255,255,255,.015);border:1px solid rgba(255,255,255,.04);overflow:hidden;transition:all .5s}
.project-card:hover{border-color:rgba(255,255,255,.08);transform:translateY(-4px);box-shadow:0 25px 50px rgba(34,211,238,.03)}
.project-bar{height:4px}
.project-bar.g1{background:linear-gradient(90deg,#06b6d4,#2563eb)}
.project-bar.g2{background:linear-gradient(90deg,#3b82f6,#a855f7)}
.project-body{padding:2rem}
.project-icon-row{display:flex;align-items:flex-start;justify-content:space-between;margin-bottom:1.5rem}
.project-icon{width:3.5rem;height:3.5rem;border-radius:1rem;display:flex;align-items:center;justify-content:center;transition:transform .3s}
.project-card:hover .project-icon{transform:scale(1.1)}
.project-icon svg{width:24px;height:24px;color:#fff}
.project-link{padding:.5rem;border-radius:.5rem;color:#4b5563;transition:all .2s}
.project-link:hover{color:#fff;background:rgba(255,255,255,.04)}
.project-link svg{width:18px;height:18px}
.project-card h3{font-size:1.5rem;font-weight:700;color:#fff;margin-bottom:.25rem}
.project-card .subtitle{font-size:.875rem;font-weight:500;margin-bottom:1rem}
.project-card .subtitle.g1{background:linear-gradient(135deg,#06b6d4,#2563eb);-webkit-background-clip:text;-webkit-text-fill-color:transparent;background-clip:text}
.project-card .subtitle.g2{background:linear-gradient(135deg,#3b82f6,#a855f7);-webkit-background-clip:text;-webkit-text-fill-color:transparent;background-clip:text}
.project-card .desc{color:#9ca3af;font-size:.875rem;line-height:1.6;margin-bottom:1.5rem}
.project-card h4{font-size:.75rem;font-weight:600;color:#6b7280;text-transform:uppercase;letter-spacing:.05em;margin-bottom:.75rem}
.project-card ul{list-style:none;margin-bottom:1.5rem}
.project-card li{display:flex;align-items:flex-start;gap:.5rem;color:#9ca3af;font-size:.875rem;margin-bottom:.5rem}
.project-card li::before{content:'';display:block;width:6px;height:6px;border-radius:50%;margin-top:6px;flex-shrink:0}
.project-card li.g1::before{background:linear-gradient(135deg,#06b6d4,#2563eb)}
.project-card li.g2::before{background:linear-gradient(135deg,#3b82f6,#a855f7)}
.tech-tags{display:flex;flex-wrap:wrap;gap:.5rem}
.tech-tag{padding:.25rem .75rem;font-size:.75rem;font-weight:500;border-radius:9999px;background:rgba(255,255,255,.04);color:#9ca3af;border:1px solid rgba(255,255,255,.04)}

/* ─── Education ─── */
.edu-wrapper{position:relative;max-width:48rem;margin:0 auto}
.edu-line{position:absolute;left:1.5rem;top:0;bottom:0;width:1px;background:linear-gradient(180deg,rgba(34,211,238,.4),rgba(59,130,246,.4),rgba(168,85,247,.4))}
.edu-item{position:relative;display:flex;gap:2rem;margin-bottom:3rem}
.edu-dot{position:absolute;left:1.5rem;transform:translateX(-50%);z-index:10;width:3rem;height:3rem;border-radius:50%;display:flex;align-items:center;justify-content:center;box-shadow:0 10px 25px rgba(0,0,0,.3)}
.edu-dot svg{width:20px;height:20px;color:#fff}
.edu-card{margin-left:3rem;flex:1;padding:1.5rem;border-radius:1rem;background:rgba(255,255,255,.015);border:1px solid rgba(255,255,255,.04);transition:all .3s}
.edu-card:hover{border-color:rgba(255,255,255,.08)}
.edu-card h3{font-size:1.125rem;font-weight:700;color:#fff;margin-bottom:.25rem}
.edu-card .institution{color:#9ca3af;font-size:.875rem;margin-bottom:.125rem}
.edu-card .loc{color:#6b7280;font-size:.75rem}
.edu-card .period{color:#6b7280;font-size:.75rem;font-weight:500;margin-top:.5rem}

/* ─── Contact ─── */
.contact-grid{display:grid;grid-template-columns:1fr 1fr;gap:3rem;max-width:56rem;margin:0 auto}
.contact-cards{display:flex;flex-direction:column;gap:1rem}
.contact-card{display:flex;align-items:center;gap:1rem;padding:1rem;border-radius:.75rem;background:rgba(255,255,255,.015);border:1px solid rgba(255,255,255,.04);transition:all .3s}
.contact-card:hover{border-color:rgba(255,255,255,.08);transform:translateY(-2px)}
.contact-card-icon{width:3rem;height:3rem;border-radius:.75rem;display:flex;align-items:center;justify-content:center;flex-shrink:0;transition:transform .3s}
.contact-card:hover .contact-card-icon{transform:scale(1.1)}
.contact-card-icon svg{width:20px;height:20px;color:#fff}
.contact-card .label{color:#6b7280;font-size:.75rem;text-transform:uppercase;letter-spacing:.05em}
.contact-card .value{color:#fff;font-size:.875rem;font-weight:500}
.contact-form{display:flex;flex-direction:column;gap:1rem}
.form-group label{display:block;font-size:.75rem;font-weight:500;color:#6b7280;text-transform:uppercase;letter-spacing:.05em;margin-bottom:.5rem}
.form-group input,.form-group textarea{width:100%;padding:.75rem 1rem;border-radius:.75rem;background:rgba(255,255,255,.02);border:1px solid rgba(255,255,255,.04);color:#fff;font-size:.875rem;font-family:inherit;transition:all .2s;outline:none}
.form-group input::placeholder,.form-group textarea::placeholder{color:#4b5563}
.form-group input:focus,.form-group textarea:focus{border-color:rgba(34,211,238,.4);box-shadow:0 0 0 2px rgba(34,211,238,.1)}
.form-group textarea{resize:none}
.btn-send{width:100%;display:flex;align-items:center;justify-content:center;gap:.5rem;padding:.875rem 1.5rem;background:linear-gradient(135deg,#06b6d4,#2563eb);color:#fff;font-weight:600;border-radius:.75rem;border:none;cursor:pointer;font-size:.9rem;transition:all .3s;font-family:inherit}
.btn-send:hover{box-shadow:0 8px 24px rgba(6,182,212,.25);transform:translateY(-2px)}
.btn-send svg{width:16px;height:16px}

/* ─── Footer ─── */
.footer{padding:2rem 1.5rem;border-top:1px solid rgba(255,255,255,.04)}
.footer-inner{max-width:72rem;margin:0 auto;display:flex;align-items:center;justify-content:space-between;flex-wrap:wrap;gap:1rem}
.footer-text{color:#6b7280;font-size:.875rem;display:flex;align-items:center;gap:.375rem}
.footer-text .heart{color:#ef4444;fill:#ef4444}
.footer-links{display:flex;align-items:center;gap:1rem}
.footer-links a{color:#6b7280;transition:color .2s}
.footer-links a:hover{color:#fff}
.footer-links svg{width:18px;height:18px}

/* ─── Responsive ─── */
@media(max-width:768px){
  .nav-links{display:none}
  .mobile-toggle{display:block}
  .mobile-menu{display:block}
  .hero-content{flex-direction:column-reverse;text-align:center;gap:3rem;padding-top:5rem}
  .hero-text h1{font-size:2.25rem}
  .hero-photo img{width:12rem;height:12rem}
  .hero-btns{justify-content:center}
  .about-grid{grid-template-columns:1fr;gap:2rem}
  .skills-grid{grid-template-columns:1fr}
  .projects-grid{grid-template-columns:1fr}
  .contact-grid{grid-template-columns:1fr}
  .section-title{font-size:2rem}
  .edu-dot{left:1.5rem}
  .edu-card{margin-left:3rem}
}
@media(max-width:480px){
  .hero-text h1{font-size:1.75rem}
  .hero-btns{flex-direction:column;align-items:stretch}
  .about-highlights{grid-template-columns:1fr}
}
</style>
</head>
<body>

